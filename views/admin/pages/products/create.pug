extends ../../layouts/default.pug
include ../../mixins/alert.pug
include ../../mixins/selectTree.pug
block main 
  if(role.permission.includes("products_create"))
    +alert-error(5000)
    h1(class="mb-4") Thêm sản phẩm mới
    form(action=`${prefixAdmin}/products/create`
      method="POST"
      id="form-create-product"
      enctype="multipart/form-data"
    )
      div(class="form-group")
        lable(for="title") Tiêu đề
        input(type="text"
          class="form-control"
          id="title"
          name="title"
          
        )
      
      div(class="form-group")
        lable(for="product_category_id") Danh mục
        select(
          class="form-control"
          id="product_category_id"
          name="product_category_id"
        )
          option(value="") Chọn danh mục
          if(category)
            +selectTree(category)

      div(class="form-group form-check form-check-inline")
        input(
          type="radio"
          class="form-check-input"
          id="featured1"
          name="featured"
          value="1"
        )
        label(for="featured1" class="form-check-label") Nổi bật

      div(class="form-group form-check form-check-inline")
        input(
          type="radio"
          class="form-check-input"
          id="featured0"
          name="featured"
          value="0"
          checked
        )
        label(for="featured0" class="form-check-label") Không nổi bật


      div(class="form-group")
        lable(for="desc") Mô tả
        textarea(type="text"
          class="form-control"
          id="desc"
          name="description"
          rows="5"
        )
      div(class="form-group")
        lable(for="price") Giá
        input(type="number"
          class="form-control"
          id="price"
          name="price"
          value="0"
          min="0"
        )
      div(class="form-group")
        lable(for="price") % Giảm giá
        input(type="number"
          class="form-control"
          id="discount"
          name="discountPercentage"
          value="0"
          min="0"
        )
      div(class="form-group")
        lable(for="title") Số lượng
        input(type="number"
          class="form-control"
          id="stock"
          name="stock"
        )
      div(class="form-group" upload-image)
        label(for="thumbnail") Ảnh
        input(
          class="form-control-file"
          type="file"
          id="thumbnail"
          upload-image-input
          accept="image/*"
          name="thumbnail"
        ) 
        img(
          src=""
          upload-image-review
          class="image-review"
        )
        <i class="bi bi-x-lg hidden" button-close-image> </i>
      div(class="form-group")
        lable(for="title") Vị trí
        input(type="number"
          class="form-control"
          id="position"
          name="position"
          placeholder="Tự động tăng"
          min="1"
        )
      div(class="form-group form-check form-check-inline")
        input(type="radio"
          class="form-check-input"
          id="statusActive"
          name="status"
          value="active"
          checked
        )
        label(for="statusActive" class="form-check-label") Hoạt động
      div(class="form-group form-check form-check-inline")
        input(type="radio"
          class="form-check-input"
          id="statusInActive"
          name="status"
          value="inactive"
        )
        label(for="statusInActive" class="form-check-label")  Ngưng hoạt động
      div(class="form-group")
        button(
          type="submit"
          class="btn btn-success"
        ) Tạo mới
  else 
    h1 Bạn không có quyền