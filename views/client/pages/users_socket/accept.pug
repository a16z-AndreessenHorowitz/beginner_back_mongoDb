extends ../../layouts/default.pug
include ../../mixins/box-head.pug

block main
  .container.my-3 
    include ../../partials/list-btn-user.pug

    .row 
      .col-12 
        +box-head("Lời mời đã nhận")

    //- thuộc tính tự định nghĩa để bắt sự kiện cho nó thêm ngừoi dùng
    .row(data-users-accept=user.id)
      .col-6 
        each user in users 
          div(class="box-user")
            div(class="inner-avatar")
              img(src=user.avatar ? user.avatar : "/upload/User.svg.png")

            div(class="inner-info")
              div(class="inner-name") #{user.fullName} 
              div(class="inner-buttons")
                button(class="btn btn-primary btn-sm mr-1" btn-accept-friend=user.id) Chấp nhận
                button(class="btn btn-secondary btn-sm mr-1" btn-refuse-friend=user.id) Xoá
                button(class="btn btn-primary btn-sm mr-1" btn-deleted-friend=user.id disabled) Đã xoá
                button(class="btn btn-primary btn-sm mr-1" btn-accepted-friend=user.id disabled) Đã chấp nhận



  block script 
    script(src="/client/js/user_socket.js") 